#!/bin/sh
set -e

. /usr/share/debconf/confmodule
. /usr/share/dbconfig-common/dpkg/postinst.mysql

dbc_mysql_createdb_encoding="UTF8"

            dbc_generate_include_args="-U -o template_infile=/usr/lib/multiflexi-eu/.env.template"
            dbc_generate_include=template:/etc/multiflexi-eu/.env
            dbc_generate_include_owner="root:www-data"
            dbc_generate_include_perms="640"

            db_get multiflexi-eu/db/app-user || true
            if [ -z "$RET" ] || echo "$RET" | grep -q "doesn't exist"; then
                export dbc_dbuser=multiflexi_eu
            else
                export dbc_dbuser="$RET"
            fi
            db_get multiflexi-eu/db/dbname || true
            if [ -z "$RET" ] || echo "$RET" | grep -q "doesn't exist"; then
                export dbc_dbname=multiflexi_eu
            else
                export dbc_dbname="$RET"
            fi

            # Ensure target database exists before dbconfig-common privilege checks
            if command -v mysql >/dev/null 2>&1; then
                if [ -r /etc/mysql/debian.cnf ]; then
                    MYSQL_ADMIN_OPTS="--defaults-file=/etc/mysql/debian.cnf"
                else
                    MYSQL_ADMIN_OPTS="-uroot"
                fi
                mysql ${MYSQL_ADMIN_OPTS} \
                    -e "CREATE DATABASE IF NOT EXISTS \`$dbc_dbname\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" || true
            fi

            dbc_go multiflexi-eu "$@"

            # Run database migrations
            if [ -f /usr/lib/multiflexi-eu/phinx-adapter.php ]; then
                phinx migrate -c /usr/lib/multiflexi-eu/phinx-adapter.php 2>/dev/null || true
            fi

#DEBHELPER#

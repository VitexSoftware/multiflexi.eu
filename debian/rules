#!/usr/bin/make -f

PKG_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/~.*//')
PKG_SOURCE  := $(shell jq -r '.name' composer.json)

%:
	dh $@

override_dh_install:
	mkdir -p debian/tmp/
	jq '.version = "'`dpkg-parsechangelog | sed -n 's/^Version: //p'| sed 's/~.*//'`'"'  composer.json |sponge debian/tmp/composer.json
	dh_install
	sed -i "1a defined('APP_NAME') || define('APP_NAME', '$(PKG_SOURCE)');" \
		debian/multiflexi-eu/usr/share/php/multiflexi-eu/autoload.php
	sed -i "2a defined('APP_VERSION') || define('APP_VERSION', '$(PKG_VERSION)');" \
		debian/multiflexi-eu/usr/share/php/multiflexi-eu/autoload.php
	# Fix vendor autoload path for Debian
	sed -i -e "s|\.\./vendor/autoload\.php|/usr/share/php/multiflexi-eu/autoload.php|g" debian/multiflexi-eu/usr/share/multiflexi-eu/init.php
	sed -i -e "s|\.\./vendor/autoload\.php|/usr/share/php/multiflexi-eu/autoload.php|g" debian/multiflexi-eu/usr/lib/multiflexi-eu/*.php
	# Fix .env path for Debian
	sed -i -e '/dirname(__DIR__)/c\    "/etc/multiflexi-eu/.env"' debian/multiflexi-eu/usr/share/multiflexi-eu/init.php
	sed -i -e "s|'\.\.\/\.env'|\"/etc/multiflexi-eu/.env\"|g" debian/multiflexi-eu/usr/lib/multiflexi-eu/*.php
	# Fix i18n path
	sed -i -e 's|\.\./i18n|/usr/share/locale|g' debian/multiflexi-eu/usr/share/multiflexi-eu/init.php
	# Fix composer.json path in PageBottom
	sed -i -e 's|composer\.json|/usr/lib/multiflexi-eu/composer.json|g' debian/multiflexi-eu/usr/lib/multiflexi-eu/MultiFlexi/Ui/PageBottom.php
	# Copy .env.template for mysql (non-sqlite path)
	sed -i '/DB_DATABASE/c\DB_DATABASE=_DBC_DBNAME_' debian/multiflexi-eu-mysql/usr/lib/multiflexi-eu/.env.template || true
